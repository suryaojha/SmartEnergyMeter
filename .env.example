PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/energyMeterDB
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# SMTP is required to send one-time password reset codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Private random string of at least 32 characters; required for database-managed SMTP passwords.
SMTP_CONFIG_KEY=
APP_URL=http://localhost:5000

# Use a private random string of at least 32 characters to encrypt Wi-Fi passwords stored in MongoDB.
WIFI_CONFIG_KEY=
